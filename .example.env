# Database
DATABASE_URL=postgres://username:password@localhost:5432/qrpresso

# Postgres
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=qrpresso

# BETTER AUTH
BETTER_AUTH_SECRET=change_this_secret_to_a_random_string
BETTER_AUTH_URL=http://localhost:3000


# MINIO
MINIO_ROOT_USER=username
MINIO_ROOT_PASSWORD=password
# MINIO ENDPOINT
MINIO_ENDPOINT=http://localhost:9000

# EMAIL SERVICE
# GMAIL
MAIL_HOST=smtp.mail.com
MAIL_FROM=User Name <example@mail.com>
MAIL_PORT=587
MAIL_USER=example@mail.com
MAIL_PASSWORD=password
MAIL_SECURE=false